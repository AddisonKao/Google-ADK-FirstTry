# ── LLM Mode (choose one) ──────────────────────────────────────────────────

# Mode 1: Gemini (default)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Mode 2: OpenAI-compatible endpoint
# If both OPENAI_API_BASE and OPENAI_API_KEY are set, this mode takes priority.
#OPENAI_API_BASE=https://your-endpoint/v1
#OPENAI_API_KEY=your-api-key
#OPENAI_MODEL=gpt-4o

# ── RAG / Embedding ─────────────────────────────────────────────────────────
# Embedding mode: leave EMBEDDING_API_BASE empty to use Gemini (default)
EMBEDDING_MODEL=gemini-embedding-001
#EMBEDDING_API_BASE=https://your-endpoint/v1
#EMBEDDING_API_KEY=your-api-key
RAG_TOP_K=5
INGEST_MAX_RECORDS=0          # 0 = all records; set e.g. 500 to limit ingest size
INGEST_BATCH_SIZE=100          # number of records per embedding batch

# ── Langfuse ─────────────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-...        # From Langfuse UI → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...        # From Langfuse UI → Settings → API Keys
LANGFUSE_HOST=http://langfuse:3000   # Internal docker network address
LANGFUSE_ENVIRONMENT=production      # dev | staging | production
LANGFUSE_TRACING_ENABLED=false       # Disable Langfuse SDK's auto OTel (requires Langfuse v3)
# For docker-compose.infra.yml internal secrets (can leave as default for local)
# LANGFUSE_NEXTAUTH_SECRET=changeme-secret-32chars-minimum
# LANGFUSE_SALT=changeme-salt

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── OTel ─────────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=kafka-adk-agent
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://langfuse:langfuse@postgres:5432/langfuse
